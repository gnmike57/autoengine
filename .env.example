# ─── AUTOMATION ENGINE — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values before running.
# All variables are optional unless marked REQUIRED.

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite database file path (default: ./data/automation.db)
DB_PATH=./data/automation.db

# ─── Proxy ────────────────────────────────────────────────────────────────────
# Proxy pool to use. "off" = no proxy (direct). "6" = Flame Sticky AU pool.
# See config/proxy-config.json for pool definitions.
PROXY_POOL=off

# ─── Browser Backend ──────────────────────────────────────────────────────────
# Default backend: camoufox | cloakbrowser | zendriver | stealth | curl
BACKEND=camoufox

# ─── Concurrency ──────────────────────────────────────────────────────────────
# Number of concurrent browser sessions (default: 4, max: 16)
CONCURRENCY=4

# ─── Video Recording ──────────────────────────────────────────────────────────
# Set to "true" to record .webm video for every session
RECORD_VIDEO=true
# Directory where recordings are saved (default: ./recordings)
RECORDINGS_DIR=./recordings

# ─── Camoufox ─────────────────────────────────────────────────────────────────
# Camoufox binary path (auto-detected if installed via npm)
# CAMOUFOX_PATH=/path/to/camoufox

# ─── CloakBrowser ─────────────────────────────────────────────────────────────
# CloakBrowser API key (REQUIRED if using cloakbrowser backend)
# CLOAKBROWSER_API_KEY=your_api_key_here

# ─── Zendriver ────────────────────────────────────────────────────────────────
# Zendriver uses Python via uv. No API key needed.
# Python must be available and uv must be installed (see SETUP.md).
# ZENDRIVER_PYTHON=python3

# ─── AI Verification ──────────────────────────────────────────────────────────
# OpenAI API key for AI video verification (optional)
# OPENAI_API_KEY=sk-...

# ─── Logging ──────────────────────────────────────────────────────────────────
# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info
# Log file path (optional, logs to stdout if not set)
# LOG_FILE=./logs/engine.log

# ─── Server ───────────────────────────────────────────────────────────────────
# Port for the dashboard server (default: 3000)
PORT=3000

# ─── Mullvad API & Proxy ──────────────────────────────────────────────────────
# Account number (16 digits) for dynamic wireproxy-api integration
MULLVAD_ACCOUNT_ID=
# Country code (e.g. us, uk, au) to filter proxies dynamically
MULLVAD_PROXY_COUNTRY=
# Mode: "disabled" | "os-socks" | "wireproxy" | "wireproxy-api" | "mullvad-cli"
MULLVAD_SESSION_MODE=wireproxy-api
