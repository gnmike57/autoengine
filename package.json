{
  "name": "automation-scripts",
  "version": "2.0.0",
  "description": "Dual-target credential validator with Australian VPN",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "prestart": "npm run clean:zombies",
    "start": "npx tsx --expose-gc src/server/server.ts",
    "pregui": "npm run clean:zombies",
    "gui": "npx tsx --expose-gc src/server/server.ts",
    "mcp:start": "npx tsx src/server/mcp.ts",
    "pregui:nocheck": "npm run clean:zombies",
    "gui:nocheck": "npx tsx --expose-gc -e \"process.env.SKIP_NPM_CHECK='1'; import('./src/server/server.ts')\"",
    "pregui:full": "npm run clean:zombies",
    "gui:full": "npx tsx --expose-gc -e \"process.env.SKIP_NPM_CHECK='1'; import('./src/server/server.ts')\"",
    "pregui:dev": "npm run clean:zombies",
    "gui:dev": "npx tsx --expose-gc -e \"process.env.SKIP_NPM_CHECK='1'; import('./src/server/server.ts')\"",
    "pretest": "npm run clean:zombies",
    "test": "npx vitest run",
    "test:coverage": "npx vitest run --coverage",
    "test:flaky": "npx vitest run --config vitest.flaky.config.ts",
    "test:visual": "npx vitest run tests/stealth/visual-regression.test.ts",
    "test:e2e": "npx playwright test",
    "test:upload": "npx playwright test && npx tdpw upload ./playwright-report --token=$TESTDINO_TOKEN --upload-html",
    "test:cloud": "npx tsx src/scripts/test-cloud-pipeline.ts",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "test:mutate": "npx stryker run",
    "benchmark": "npx tsx src/utils/isolated-test-runner.ts run-golden-benchmark.ts",
    "test:tile": "npx tsx src/utils/isolated-test-runner.ts tests/live/golden-tile-test.ts",
    "calibrate": "npx tsx src/scripts/calibrate-coordinates.ts",
    "test:tile:ignition": "npx tsx src/utils/isolated-test-runner.ts tests/live/ignition-tile-test.ts",
    "test:tile:mega": "npx tsx src/utils/isolated-test-runner.ts tests/live/mega-tile-test.ts",
    "batch:start": "npx tsx src/scripts/cli-start-batch.ts",
    "review": "npx tsx src/hermes/hermes-review.ts",
    "vision-optimize": "npx tsx src/hermes/vision-optimizer.ts",
    "fp-audit": "npx tsx scripts/fingerprint-improve-loop.ts",
    "warm-cache": "npx tsx src/services/warm-static-cache.ts",
    "typecheck": "npx tsc --noEmit",
    "clean:zombies": "npx tsx src/services/clean-zombies.ts",
    "clean:zombies:dry": "npx tsx src/services/clean-zombies.ts --dry",
    "hard-reset": "npx tsx src/services/hard-reset.ts",
    "hard-reset:dry": "npx tsx src/services/hard-reset.ts --dry",
    "sync:ua": "npx tsx scripts/generate-ua-pool.ts",
    "golden-watch": "npx tsx src/services/golden-watcher.ts",
    "calibrate-cookies": "npx tsx src/intelligence/cookie-calibrator.ts",
    "rename-recordings": "npx tsx src/services/rename-recordings.ts",
    "daemon:start": "pm2 start ecosystem.config.cjs",
    "daemon:stop": "pm2 stop all",
    "daemon:restart": "pm2 restart all",
    "daemon:status": "pm2 status",
    "daemon:logs": "pm2 logs --lines 100",
    "daemon:install": "powershell -File scripts/install-daemon.ps1",
    "build": "tsc -p tsconfig.json",
    "serve:prod": "node dist/server/server.js",
    "build:portable": "npx tsx scripts/build-portable-zip.ts",
    "build:architecture": "npx tsx scripts/generate-architecture.ts",
    "evidence:matrix:build": "python3 scripts/evidence/build_matrix.py",
    "evidence:matrix:run": "npx tsx scripts/run-evidence-matrix.ts",
    "evidence:matrix:verify": "python3 scripts/evidence/verify_evidence.py",
    "evidence:matrix:summarize": "npx tsx scripts/summarize-login-step-comparisons.ts",
    "setup": "bash setup.sh",
    "dev": "npx tsx --expose-gc src/server/server.ts",
    "golden": "npx tsx src/services/golden-watcher.ts",
    "pm2": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop all",
    "pm2:logs": "pm2 logs --lines 100"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1070.0",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/genai": "^2.7.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@spider-cloud/spider-client": "^0.2.0",
    "@thumbmarkjs/thumbmarkjs": "^1.9.1",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.11.1",
    "camoufox-js": "^0.11.5",
    "chokidar": "^5.0.0",
    "cloakbrowser": "^0.5.4",
    "csv-parse": "^7.0.0",
    "curl-cffi-node": "^0.1.8",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "fingerprint-generator": "^2.1.82",
    "fingerprint-injector": "^2.1.82",
    "fluent-ffmpeg": "^2.1.3",
    "ghost-cursor-playwright": "^2.1.0",
    "google-auth-library": "^11.0.0",
    "http-mitm-proxy": "^1.1.0",
    "httpcloak": "^1.6.8-beta.1",
    "https-proxy-agent": "^9.0.0",
    "ioredis": "^6.0.0",
    "mmdb-lib": "^3.0.2",
    "node-fetch": "^3.3.2",
    "node-window-manager": "^2.2.4",
    "ollama": "^0.6.3",
    "p-limit": "^7.3.0",
    "patchright": "^1.60.2",
    "playwright": "^1.61.0",
    "playwright-core": "^1.59.1",
    "prom-client": "^15.1.3",
    "python": "^0.0.4",
    "screenshot-desktop": "^1.15.4",
    "sharp": "^0.35.2",
    "socks": "^2.8.3",
    "socks-proxy-agent": "^10.0.0",
    "spider-browser": "^0.3.0",
    "ua-parser-js": "^2.0.10",
    "ws": "^8.21.0",
    "yargs": "^18.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/supertest": "^7.2.1",
    "@types/ua-parser-js": "^0.7.39",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "pm2": "^7.0.1",
    "supertest": "^7.2.2",
    "tdpw": "^1.0.37",
    "ts-morph": "^28.0.0",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "overrides": {
    "js-yaml": "^4.2.0",
    "uuid": "^11.1.1",
    "pm2": {
      "ws": "^8.21.0"
    },
    "adm-zip": "^0.6.0",
    "brace-expansion": "^1.1.11",
    "qs": "^6.13.0",
    "archiver": "^7.0.1",
    "rimraf": "^4.0.0",
    "screenshot-desktop": "^1.15.4"
  }
}
